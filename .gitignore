# =============================================================================
# 工作区根 .gitignore
# 目标：把可同步的内容控制在约 30 MB 以内，排除所有可再生的重型产物。
# =============================================================================

# ---- 虚拟环境（457.6 MB，必须排除）----
# 新机器上用 requirements.txt 重建即可：
#     python -m venv venv && venv\Scripts\pip install -r recruitment-squad-intelligence/requirements.txt
venv/
.venv/
env/
ENV/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 编辑器 / 工具配置（含本机路径与凭据痕迹）----
.idea/
.vscode/
.claude/
*.iml
*.swp

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 空文件与临时产物 ----
claude-code
*.tmp
*.bak
~$*

# ---- 生成的产物 ----
# 判断原则：**体积小 + 换机后需要直接可用 -> 纳入**；**体积大或可秒级重建 -> 排除**。
#
# recruitment-squad-intelligence/data/processed/ 是 M1 的交付物（约 1.5 MB），
# 换机后应能直接使用，因此**纳入**（下面的 ! 规则显式放行）。
# 中间产物与图表缓存可重建，故排除。
recruitment-squad-intelligence/data/interim/*
recruitment-squad-intelligence/reports/figures/*.png

# 默认忽略 processed 下的所有内容，再显式放行交付物。
# 这样新增的临时文件不会意外被提交，而交付物始终受版本控制。
recruitment-squad-intelligence/data/processed/*
!recruitment-squad-intelligence/data/processed/.gitkeep
!recruitment-squad-intelligence/data/processed/players_*.csv
!recruitment-squad-intelligence/data/processed/inter_squad_*.csv
!recruitment-squad-intelligence/data/processed/candidate_pool_*.csv
!recruitment-squad-intelligence/data/processed/contracts_*.csv

# 数据质量报告（体积小，且是 M1 的验收依据）
!recruitment-squad-intelligence/reports/analysis/M1_*.md
!recruitment-squad-intelligence/reports/analysis/M1_*.json
!recruitment-squad-intelligence/data/interim/.gitkeep
!recruitment-squad-intelligence/reports/figures/.gitkeep

# 审计阶段的干净数据层原型（体积小，作为可行性证据保留，已在首次提交中纳入）
!\_audit/processed/*.csv

# ---- 本地覆盖配置与凭据 ----
.env
.env.*
*.local.yaml
config/local.yaml

# ---- GitHub 上传清单（本机生成，含绝对路径，无需同步）----
GITHUB_UPLOAD_MANIFEST.txt

# ---- 逐文件排除清单（见 GITHUB_SYNC_NOTES.md 说明）----
_audit/.sensitive_exclude
